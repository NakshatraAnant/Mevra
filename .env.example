# Copy to .env.local (npm run dev creates one automatically with safe local defaults)
DATABASE_URL=postgres://user:password@host:5432/mevra   # Supabase/any Postgres 15+
EMBEDDED_POSTGRES=0            # 1 = run the bundled local PostgreSQL
PORT=3100
NEXT_PUBLIC_SITE_URL=https://your-domain.example
ADMIN_EMAIL=owner@example.com  # used once, when the first owner account is seeded
ADMIN_PASSWORD=change-me-long-random
# Online payments stay disabled until a provider is implemented AND enabled in admin settings
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional adapters. Leave empty to keep the development fallback (recorded, never sent).
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
SHIPPING_API_URL=
SHIPPING_API_KEY=
META_PIXEL_ID=
META_CAPI_TOKEN=
GA_MEASUREMENT_ID=
GA_API_SECRET=
